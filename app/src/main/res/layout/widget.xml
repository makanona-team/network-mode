<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp"
    android:background="@drawable/w_bg" android:layoutDirection="locale">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1"
        android:ellipsize="end" android:paddingBottom="2dp" />
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FF9BA8A4" android:textSize="12sp" android:maxLines="1" android:paddingBottom="6dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/b0" style="@style/WBtn" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/b1" style="@style/WBtn" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/b2" style="@style/WBtn" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/b3" style="@style/WBtn" />
    </LinearLayout>
</LinearLayout>
